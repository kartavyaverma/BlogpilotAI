# LLM Provider Configuration
# One of: groq | openrouter | moonshot | gemini | openai
# Default recommendation: groq (Kimi K2, free tier, fast, strong tool use)
LLM_PROVIDER=groq
LLM_TEMPERATURE=0

# Kimi K2 via Groq - free tier, fastest. Key: https://console.groq.com -> API Keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=moonshotai/kimi-k2-instruct-0905

# Kimi K2 via OpenRouter (free variant, good fallback when Groq rate limits hit)
# Key: https://openrouter.ai -> Keys
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=moonshotai/kimi-k2:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Kimi K2 direct from Moonshot (paid). Key: https://platform.moonshot.ai -> API Keys
MOONSHOT_API_KEY=your_moonshot_api_key
MOONSHOT_MODEL=kimi-k2-0905-preview
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Gemini Settings (used if LLM_PROVIDER=gemini, and always for image generation)
# GOOGLE_API_KEY stays useful with Kimi K2: diagrams are still drawn by Gemini.
# Without it, the article is still written and image blocks are skipped.
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# OpenAI Settings (used if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

DATABASE_URL=postgresql://user:password@host:5432/dbname

TAVILY_API_KEY=your_tavily_api_key
TAVILY_MAX_RESULTS=6

APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
