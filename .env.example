# LLM Provider Configuration
# One of: groq | moonshot | gemini | openai
#   groq     -> free, tested end to end (see README "Choosing models per task")
#   moonshot -> Kimi, best quality, paid (~$0.06 per article)
LLM_PROVIDER=groq
LLM_TEMPERATURE=0
# Caps output tokens per agent call. Credit-limited gateways reject requests
# that reserve the model's full output window, so keep this set.
LLM_MAX_TOKENS=8000
# Retries on HTTP 429; the SDK waits out the provider's retry-after window.
LLM_MAX_RETRIES=6
# Max agent calls in flight at once. 0 = unlimited (fastest, use on paid plans).
# Groq's free tier allows 8,000 tokens/min per model; 2 keeps a run under it.
LLM_MAX_CONCURRENCY=2

# Optional per-task models (same provider/key). Unset = provider default model.
#   ROUTER   classify topic + write search queries   (small, needs reliable JSON)
#   RESEARCH extract evidence from search results    (reads the most input)
#   PLANNER  design the article outline              (reasoning quality)
#   WRITER   write each section, runs in parallel    (writing quality, most tokens)
#   IMAGES   pick where diagrams go                  (reads the whole article)
# LLM_MODEL_ROUTER=
# LLM_MODEL_RESEARCH=
# LLM_MODEL_PLANNER=
# LLM_MODEL_WRITER=
# LLM_MODEL_IMAGES=

# Groq - free. It serves no Kimi model. openai/gpt-oss-120b is the only free
# Groq model that completed the full pipeline in testing (gpt-oss-20b produced
# malformed tool calls; qwen3.8-27b spent its token budget reasoning).
# Current catalogue: https://console.groq.com/docs/models
# Key: https://console.groq.com -> API Keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Kimi direct from Moonshot. PAID: the account needs a balance, there is no
# free tier. ~$0.95 per 1M input tokens and $4.00 per 1M output tokens for
# kimi-k2.6. Key: https://platform.moonshot.ai -> API Keys
# Pricing: https://platform.moonshot.ai/docs/pricing/chat
MOONSHOT_API_KEY=your_moonshot_api_key
MOONSHOT_MODEL=kimi-k2.6
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Diagrams. "mermaid" (default): the LLM writes each figure as Mermaid code and
# Kroki renders it to PNG - free, no key, exact labels. "gemini": Gemini image
# model, needs GOOGLE_API_KEY.
IMAGE_PROVIDER=mermaid
KROKI_URL=https://kroki.io

# Gemini Settings (used if LLM_PROVIDER=gemini, or IMAGE_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# OpenAI Settings (used if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

DATABASE_URL=postgresql://user:password@host:5432/dbname

TAVILY_API_KEY=your_tavily_api_key
TAVILY_MAX_RESULTS=6
# Search results are deduped, clipped and capped before the research model
# reads them, so the prompt stays small (and cheap) on every provider.
RESEARCH_SNIPPET_CHARS=500
RESEARCH_MAX_RESULTS=24

APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
